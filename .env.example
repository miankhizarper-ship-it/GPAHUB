# ---------------------------------------------------------------------------
# GPAHub environment variables
# ---------------------------------------------------------------------------
#
# This file documents the environment variables GPAHub expects.
# Copy to `.env.local` for local development and fill in real values.
#
# NEVER commit real secrets. `.env*` is git-ignored except this example.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (server-side only).
# Example: mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Logical database name inside the Atlas cluster.
# Falls back to "gpahub-dev" if unset (to avoid accidental prod writes).
# Production: set to "gpahub" (or your preferred name).
MONGODB_DB_NAME=gpahub

# NextAuth.js secret used to sign session JWTs.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# NextAuth URL — the app's origin. Required for correct callback URLs.
# Production: https://your-domain.com
# Development: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Admin credentials (server-side only, never exposed to the browser).
# Generate the password hash with: bun run scripts/hash-password.ts <password>
ADMIN_EMAIL=admin@gpahub.app
ADMIN_PASSWORD_HASH=

# Public site URL (used for canonical URLs, sitemaps, OG metadata).
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://gpahub.app
